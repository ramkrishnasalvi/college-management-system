        <a href="courses.aspx">Courses</a>
        <a href="Subjects.aspx">Subjects</a>
        <a href="Attendance.aspx">Attendance</a>
        <a href="#">Results</a>
        <a href="AdminLogin.aspx">Logout</a>
    </div>

